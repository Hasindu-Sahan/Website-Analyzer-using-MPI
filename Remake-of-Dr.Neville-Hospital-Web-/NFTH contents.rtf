\par \pard\plain \s0\rtlch\af14\afs24\alang1081 \ltrch\lang1033\langfe2052\hich\af3\loch\ql\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1033\kerning1\dbch\af13\langfe2052\sl276\slmult1\sb0\sa200{\rtlch\afs22 \ltrch\hich\af11\loch\fs22\b\f11\loch
3. Patient\_Friendly Environment}
\par \pard\plain \s0\rtlch\af14\afs24\alang1081 \ltrch\lang1033\langfe2052\hich\af3\loch\ql\nowidctlpar\hyphpar0\ltrpar\cf0\f3\fs24\lang1033\kerning1\dbch\af13\langfe2052\sl276\slmult1\sb0\sa200{\rtlch\afs22 \ltrch\hich\af11\loch\fs22\b0\f11\loch
